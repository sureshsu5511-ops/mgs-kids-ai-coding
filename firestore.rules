rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Put the SAME admin email here that you put in mgs.js (ADMIN_EMAIL)
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "PASTE_ADMIN_EMAIL";
    }

    // Public list of schools shown on the website
    match /public/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','students','createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                    && request.resource.data.students is int
                    && request.resource.data.students >= 1 && request.resource.data.students < 20000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Private school registrations (phone numbers etc.)
    match /schools/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','contact','phone','town','classes','students','status','createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.students is int
                    && request.resource.data.students >= 1 && request.resource.data.students < 20000;
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();

      // Students entered by each school after login
      match /students/{sid} {
        allow read, write: if isAdmin()
          || (request.auth != null
              && get(/databases/$(database)/documents/schools/$(id)).data.uid == request.auth.uid);
      }
    }
  }
}
